# =========================
# AL ZAHRA TRADE — Backend
# =========================
# Copy to .env and fill real values:
#   cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/al-zahra-trade

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=7d

# Frontend URL (CORS + referral links)
FRONTEND_URL=http://localhost:5173

# Backend public URL (optional, for absolute links)
BACKEND_URL=http://localhost:5000

# Cloudinary (REQUIRED for image uploads on production/Vercel)
# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
